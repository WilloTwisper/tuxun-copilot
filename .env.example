# 复制此文件为 .env 并填入你自己的凭证。不要提交 .env。
API_KEY="your_google_ai_api_key"

# 可选：第二个 Gemini API Key。主 Key 限流(429)时自动轮换到备用 Key
# API_KEY2="your_second_google_ai_api_key"

# 图寻登录 Cookie（fun_ticket 为 HttpOnly，需从浏览器 F12 → 应用 → Cookie 中复制）
# 支持只填 fun_ticket，或完整 Cookie 字符串（推荐）：
# TUXUN_COOKIE="fun_ticket=your_ticket; SESSION=your_session; _t_cfg=your_config_id"
TUXUN_COOKIE="fun_ticket=your_ticket"

# 可选：本地代理地址（中国大陆访问 Gemini API / Google 街景图必需，如 Clash 等）
# 注意：代理只作用于 Google 域名，图寻 API 始终直连
# PROXY="http://127.0.0.1:7897"

# 可选：Clash 控制 API（自动切换节点）。需在 Clash Verge 设置中开启"外部控制"。
# 控制器默认 127.0.0.1:9097，secret 见 Clash Verge 设置或 config.yaml
# CLASH_CONTROLLER="http://127.0.0.1:9097"
# CLASH_SECRET=""

# 可选：指定 Gemini 模型（默认 gemini-3.6-flash）
# GEMINI_MODEL="gemini-3.6-flash"

# 可选：备用模型列表（逗号分隔）。主模型限流(429)时自动轮换。
# 免费额度按模型独立计算，主模型用完可继续用备用模型：
GEMINI_MODEL_FALLBACKS="gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
